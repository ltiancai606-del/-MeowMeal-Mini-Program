page {
  background-color: #F9F7F4;
  color: #292524;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, scroll-view, input, textarea, button {
  box-sizing: border-box;
}

.page-wrap {
  min-height: 100vh;
  padding: 28rpx 32rpx 160rpx;
  background-color: #F9F7F4;
}

.card {
  background-color: #FFFFFF;
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(28, 25, 23, 0.04);
  border: 1rpx solid #F5F5F4;
}

.card-warm {
  background-color: #FFFAF5;
  border-radius: 36rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #FFEDD5;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #292524;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.link-orange {
  font-size: 24rpx;
  color: #FF7B4A;
  font-weight: 600;
}

.btn-primary {
  background-color: #FF7B4A;
  color: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.3;
  border: none;
}

.btn-primary::after,
.btn-outline::after,
.btn-secondary::after,
.btn-danger::after {
  border: none;
}

.btn-outline {
  background-color: #FFFFFF;
  color: #FF7B4A;
  border: 2rpx solid #FF7B4A;
  border-radius: 28rpx;
  padding: 22rpx 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.3;
}

.btn-secondary {
  background-color: #F5F5F4;
  color: #57534E;
  border-radius: 28rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.3;
}

.btn-danger {
  background-color: #EF4444;
  color: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.3;
}

.badge {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
  line-height: 1.4;
}

.badge-l1 {
  background-color: #ECFDF5;
  color: #047857;
  border: 1rpx solid #A7F3D0;
}

.badge-l2 {
  background-color: #F0F9FF;
  color: #0369A1;
  border: 1rpx solid #BAE6FD;
}

.badge-proxy {
  background-color: #FEF3C7;
  color: #92400E;
  border: 1rpx solid #FCD34D;
}

.badge-orange {
  background-color: #FFFAF5;
  color: #FF7B4A;
  border: 1rpx solid #FED7AA;
}

.badge-blue {
  background-color: #EFF6FF;
  color: #2563EB;
}

.badge-red {
  background-color: #FEF2F2;
  color: #DC2626;
}

.badge-green {
  background-color: #ECFDF5;
  color: #059669;
}

.badge-stone {
  background-color: #F5F5F4;
  color: #78716C;
}

.alert-danger {
  background-color: #FEF2F2;
  border: 1rpx solid #FECACA;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  color: #B91C1C;
  font-size: 24rpx;
  line-height: 1.5;
}

.alert-warning {
  background-color: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  color: #92400E;
  font-size: 24rpx;
  line-height: 1.5;
}

.alert-info {
  background-color: #F5F5F4;
  border: 1rpx solid #E7E5E4;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  color: #78716C;
  font-size: 22rpx;
  line-height: 1.5;
}

.traffic-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.traffic-green {
  background-color: #D1FAE5;
  color: #059669;
}

.traffic-yellow {
  background-color: #FEF3C7;
  color: #B45309;
}

.traffic-red {
  background-color: #FEE2E2;
  color: #DC2626;
}

.traffic-neutral {
  background-color: #F5F5F4;
  color: #A8A29E;
}

.search-box {
  background-color: #FFFFFF;
  border: 1rpx solid #F5F5F4;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.02);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #292524;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(28, 25, 23, 0.48);
  z-index: 999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.modal-sheet {
  background-color: #FFFFFF;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding: 36rpx 32rpx 48rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #292524;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background-color: #F5F5F4;
  color: #78716C;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.modal-scroll {
  flex: 1;
  max-height: 60vh;
}

.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.muted {
  color: #78716C;
  font-size: 24rpx;
}

.muted-sm {
  color: #A8A29E;
  font-size: 22rpx;
}
