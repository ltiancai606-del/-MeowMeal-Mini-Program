<view class="dash-page">
  <!-- 橙色顶栏（一体沉浸顶栏，无原生白线） -->
  <view class="dash-hero" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-title-bar" style="height: {{navBarHeight}}px;">
      <text class="custom-title-text">喵膳 MeowMeal</text>
    </view>
    <view class="hero-top">
      <view>
        <text class="hero-hello">早上好 👋</text>
        <text class="hero-title">喵膳 MeowMeal</text>
      </view>
      <view class="hero-avatar" bindtap="goProfile">
        <text class="hero-avatar-text">主</text>
      </view>
    </view>
  </view>

  <!-- 悬浮叠层：执行中食谱卡片 -->
  <view class="overlap-wrap">
    <view class="dash-card overlap-card" bindtap="goActiveRecipeDetail">
      <view class="row-between card-head-row">
        <view class="head-left">
          <view class="icon-badge-orange">🔥</view>
          <text class="head-sub">执行中食谱</text>
        </view>
        <view class="head-right">
          <text wx:if="{{activeRecipe}}" class="std-tag">{{activeRecipe.standard}}</text>
          <text class="chevron">›</text>
        </view>
      </view>

      <block wx:if="{{activeRecipe}}">
        <text class="active-title">{{activeRecipe.name}}</text>

        <view class="days-row">
          <view class="day-col">
            <text class="day-label">已执行</text>
            <view class="day-val-row">
              <text class="day-num text-orange">{{activeRecipe.executedDays}}</text>
              <text class="day-unit">天</text>
            </view>
          </view>
          <view class="day-col center">
            <text class="day-label">周期</text>
            <view class="day-val-row">
              <text class="day-num">{{activeRecipe.totalDays}}</text>
              <text class="day-unit">天</text>
            </view>
          </view>
          <view class="day-col right">
            <text class="day-label">剩余</text>
            <view class="day-val-row">
              <text class="day-num">{{activeRecipe.remainingDays}}</text>
              <text class="day-unit">天</text>
            </view>
          </view>
        </view>

        <view class="progress-inline">
          <view class="progress-track">
            <view class="progress-fill" style="width: {{activeRecipe.progressPct}}%;"></view>
          </view>
          <text class="progress-pct">{{activeRecipe.progressPct}}%</text>
        </view>
      </block>

      <view wx:else class="empty-active" catchtap="goCreateRecipe">
        <text class="muted">暂无执行中的食谱，点击前往新建 →</text>
      </view>
    </view>
  </view>

  <!-- 主体自适应填满一屏 -->
  <view class="dash-body">
    <!-- 冰箱库存 3 列卡片 -->
    <view class="dash-card flex-card">
      <view class="card-section-header" bindtap="goInventory">
        <view class="head-left">
          <view class="icon-badge-blue">🧊</view>
          <text class="card-section-title">冰箱库存</text>
        </view>
        <view class="head-right">
          <text wx:if="{{expiringCount > 0 || expiredCount > 0}}" class="warn-inline">⚠ {{expiringCount + expiredCount}}项需处理</text>
          <text class="chevron">›</text>
        </view>
      </view>

      <view class="inv-grid">
        <view class="inv-stat inv-normal" bindtap="goInventory">
          <text class="inv-num text-orange">{{normalCount}}</text>
          <text class="inv-lbl text-orange-sub">正常</text>
        </view>
        <view class="inv-stat inv-expiring" bindtap="goInventory">
          <text class="inv-num text-amber">{{expiringCount}}</text>
          <text class="inv-lbl text-amber-sub">临期</text>
        </view>
        <view class="inv-stat inv-expired" bindtap="goInventory">
          <text class="inv-num text-rose">{{expiredCount}}</text>
          <text class="inv-lbl text-rose-sub">已过期</text>
        </view>
      </view>
    </view>

    <!-- 我的猫咪横滑卡片 -->
    <view class="dash-card flex-card">
      <view class="card-section-header">
        <view class="head-left">
          <view class="icon-badge-stone">🐾</view>
          <text class="card-section-title">我的猫咪</text>
        </view>
        <text class="link-add" bindtap="goProfile">+ 添加</text>
      </view>

      <scroll-view scroll-x="true" enable-flex="true" class="cat-scroll">
        <view class="cat-row">
          <view wx:for="{{cats}}" wx:key="id" class="cat-chip" bindtap="goProfile">
            <view class="cat-avatar">🐱</view>
            <view class="cat-chip-info">
              <view class="cat-chip-top">
                <text class="cat-name">{{item.name}}</text>
                <text class="cat-status {{item.neutered ? 'status-green' : 'status-stone'}}">{{item.neutered ? '已绝育' : '未绝育'}}</text>
              </view>
              <text class="cat-meta">{{item.weight}}kg · {{item.age}}岁</text>
            </view>
          </view>

          <view class="cat-add-chip" bindtap="goProfile">
            <text>+ 添加猫咪</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 营养库：左右双列 -->
    <view class="lib-grid">
      <view class="lib-item" bindtap="goNutritionIngredients">
        <view class="nav-icon">🥩</view>
        <view class="lib-texts">
          <text class="nav-row-title">食材营养库</text>
          <text class="nav-row-sub">176 项肉类/内脏</text>
        </view>
      </view>

      <view class="lib-item" bindtap="goNutritionSupplements">
        <view class="nav-icon">💊</view>
        <view class="lib-texts">
          <text class="nav-row-title">营养剂库</text>
          <text class="nav-row-sub">10 款常见补剂</text>
        </view>
      </view>
    </view>
  </view>
</view>
