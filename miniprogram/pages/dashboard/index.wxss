.dash-page {
  min-height: 100vh;
  background-color: #F9F7F4;
  display: flex;
  flex-direction: column;
}

.dash-hero {
  background-color: #FF7B4A;
  padding: 24rpx 34rpx 96rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-hello {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: 4rpx;
}

.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.25;
}

.hero-avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background-color: #FFEDD5;
  border: 4rpx solid #FF9E7A;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-avatar-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #EA580C;
}

.overlap-wrap {
  padding: 0 28rpx;
  margin-top: -64rpx;
  position: relative;
  z-index: 10;
  flex-shrink: 0;
}

.dash-card {
  background-color: #FFFFFF;
  border-radius: 36rpx;
  padding: 30rpx 32rpx;
  box-shadow: 0 6rpx 22rpx rgba(28, 25, 23, 0.045);
  border: 1rpx solid #F5F5F4;
}

.overlap-card {
  box-shadow: 0 10rpx 28rpx rgba(255, 123, 74, 0.12);
}

.card-head-row {
  margin-bottom: 14rpx;
}

.card-section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.card-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #292524;
}

.head-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.std-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #FF7B4A;
  background-color: #FFFAF5;
  border: 1rpx solid #FFEDD5;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.warn-inline {
  font-size: 24rpx;
  font-weight: 600;
  color: #D97706;
}

.icon-badge-orange,
.icon-badge-blue,
.icon-badge-stone {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.icon-badge-orange { background-color: #FFF7ED; }
.icon-badge-blue { background-color: #EFF6FF; }
.icon-badge-stone { background-color: #F5F5F4; }

.head-sub {
  font-size: 28rpx;
  color: #78716C;
  font-weight: 600;
}

.chevron {
  font-size: 36rpx;
  color: #A8A29E;
}

.active-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #292524;
  margin-bottom: 22rpx;
}

.days-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.day-col {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.day-col.center { align-items: center; }
.day-col.right { align-items: flex-end; }

.day-label {
  font-size: 24rpx;
  color: #A8A29E;
}

.day-val-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.day-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #292524;
  line-height: 1.1;
}

.text-orange { color: #FF7B4A; }

.day-unit {
  font-size: 24rpx;
  color: #A8A29E;
}

.progress-inline {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-track {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background-color: #F5F5F4;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #FF7B4A;
  border-radius: 999rpx;
}

.progress-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF7B4A;
  flex-shrink: 0;
}

.empty-active {
  padding: 28rpx 0;
  text-align: center;
}

.dash-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx 28rpx 28rpx;
}

.flex-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.inv-grid {
  display: flex;
  gap: 20rpx;
}

.inv-stat {
  flex: 1;
  border-radius: 26rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.inv-normal { background-color: #FFFAF5; }
.inv-expiring { background-color: #FFFBEB; }
.inv-expired { background-color: #FFF1F2; }

.inv-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.1;
}

.inv-lbl {
  font-size: 24rpx;
  font-weight: 600;
}

.text-orange-sub { color: rgba(255, 123, 74, 0.9); }
.text-amber { color: #F59E0B; }
.text-amber-sub { color: #D97706; }
.text-rose { color: #F43F5E; }
.text-rose-sub { color: #E11D48; }

.link-add {
  font-size: 26rpx;
  color: #FF7B4A;
  font-weight: 700;
}

.cat-scroll {
  white-space: nowrap;
}

.cat-row {
  display: inline-flex;
  gap: 20rpx;
}

.cat-chip {
  background-color: #FAFAF9;
  border: 1rpx solid #F5F5F4;
  border-radius: 26rpx;
  padding: 20rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-shrink: 0;
}

.cat-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background-color: #FFEDD5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.cat-chip-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cat-chip-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
}

.cat-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
  white-space: nowrap;
}

.status-green {
  background-color: #D1FAE5;
  color: #059669;
}

.status-stone {
  background-color: #E7E5E4;
  color: #78716C;
}

.cat-meta {
  font-size: 24rpx;
  color: #78716C;
}

.cat-add-chip {
  border: 3rpx dashed #FDBA74;
  background-color: #FFF7ED;
  border-radius: 26rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #FF7B4A;
  flex-shrink: 0;
}

.lib-grid {
  display: flex;
  gap: 20rpx;
  flex-shrink: 0;
}

.lib-item {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 34rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #F5F5F4;
  box-shadow: 0 6rpx 20rpx rgba(28, 25, 23, 0.04);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.nav-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background-color: #FFF7ED;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.lib-texts {
  flex: 1;
  min-width: 0;
}

.nav-row-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
  margin-bottom: 4rpx;
}

.nav-row-sub {
  display: block;
  font-size: 23rpx;
  color: #A8A29E;
}
