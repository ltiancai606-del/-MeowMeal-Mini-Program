.dash-page {
  min-height: 100vh;
  background-color: #F9F7F4;
  padding-bottom: 48rpx;
}

.dash-hero {
  background: linear-gradient(135deg, #FF7B4A 0%, #FF9466 100%);
  padding: 28rpx 32rpx 44rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
  color: #FFFFFF;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.hero-hello {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  display: block;
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.hero-btn {
  background-color: #FFFFFF;
  color: #FF7B4A;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.08);
}

.hero-stats {
  display: flex;
  gap: 16rpx;
}

.stat-pill {
  flex: 1;
  background-color: rgba(255, 255, 255, 0.18);
  border-radius: 24rpx;
  padding: 18rpx 16rpx;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.stat-lbl {
  display: block;
  font-size: 20rpx;
  opacity: 0.88;
  margin-top: 4rpx;
}

.dash-body {
  padding: 28rpx 32rpx 40rpx;
}

.active-card {
  background-color: #FFFAF5;
  border: 1rpx solid #FFEDD5;
  border-radius: 28rpx;
  padding: 24rpx;
}

.active-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #292524;
}

.active-meta {
  display: flex;
  gap: 10rpx;
  font-size: 22rpx;
  color: #78716C;
  margin: 14rpx 0 18rpx;
}

.me-bar {
  height: 14rpx;
  border-radius: 999rpx;
  background-color: #E7E5E4;
  display: flex;
  overflow: hidden;
}

.me-protein {
  background-color: #FF7B4A;
  height: 100%;
}

.me-fat {
  background-color: #FBBF24;
  height: 100%;
}

.me-carb {
  background-color: #10B981;
  height: 100%;
}

.me-legend {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #78716C;
}

.empty-box {
  padding: 36rpx 20rpx;
  text-align: center;
  background-color: #FAFAF9;
  border-radius: 24rpx;
}

.cat-scroll {
  display: flex;
  white-space: nowrap;
}

.cat-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 190rpx;
  background-color: #FAFAF9;
  border: 1rpx solid #F5F5F4;
  border-radius: 28rpx;
  padding: 24rpx 16rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.cat-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background-color: #FFEDD5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.cat-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #292524;
}

.nav-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 4rpx;
}

.nav-row-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.nav-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.bg-orange-soft {
  background-color: #FFF7ED;
}

.bg-blue-soft {
  background-color: #EFF6FF;
}

.nav-row-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
  margin-bottom: 4rpx;
}

.arrow {
  font-size: 36rpx;
  color: #D6D3D1;
}

.divider {
  height: 1rpx;
  background-color: #F5F5F4;
}
