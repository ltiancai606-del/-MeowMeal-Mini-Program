<view class="detail-wrap" wx:if="{{recipe}}">
  <!-- 顶部总览卡片 -->
  <view class="card hero-card">
    <view class="hero-top">
      <view class="hero-title-wrap">
        <text class="hero-title">{{recipe.name}}</text>
        <view class="hero-tags">
          <text class="badge {{recipe.isActive ? 'badge-green' : 'badge-stone'}}">{{recipe.isActive ? '正在执行' : '未执行'}}</text>
          <text class="badge badge-orange">{{recipe.days}} 天</text>
          <text wx:if="{{catNamesText}}" class="badge badge-blue">🐱 {{catNamesText}}</text>
        </view>
      </view>
      <view class="edit-toggle-btn {{isEditing ? 'edit-toggle-active' : ''}}" bindtap="onToggleEdit">
        {{isEditing ? '取消编辑' : '编辑配方'}}
      </view>
    </view>

    <!-- 关键指标 -->
    <view class="kpi-grid">
      <view class="kpi-cell">
        <text class="kpi-val">{{summary.totalWeightG}}g</text>
        <text class="muted-sm">生鲜总重</text>
      </view>
      <view class="kpi-cell">
        <text class="kpi-val">{{summary.totalKcal}}</text>
        <text class="muted-sm">总热量 kcal</text>
      </view>
      <view class="kpi-cell">
        <text class="kpi-val {{summary.caPClass}}">{{summary.caPRatioText}}</text>
        <text class="muted-sm">钙磷比</text>
      </view>
      <view class="kpi-cell">
        <text class="kpi-val">{{summary.dailyWeightG}}g</text>
        <text class="muted-sm">日均生重</text>
      </view>
    </view>

    <!-- ME 供能比 -->
    <view class="me-bar">
      <view class="me-seg me-pro" style="width: {{summary.proteinPct}}%;"></view>
      <view class="me-seg me-fat" style="width: {{summary.fatPct}}%;"></view>
      <view class="me-seg me-carb" style="width: {{summary.carbPct}}%;"></view>
    </view>
    <view class="me-legend">
      <text>蛋白质 ME {{summary.proteinPct}}%</text>
      <text>脂肪 ME {{summary.fatPct}}%</text>
      <text>碳水 ME {{summary.carbPct}}%</text>
    </view>
  </view>

  <!-- 高风险 SUL/Max 红灯警告 -->
  <view wx:if="{{summary.highRiskAlerts.length > 0}}" class="alert-danger">
    <view class="alert-head">🚨 高风险超标警报（超过 SUL / Max 上限）</view>
    <view wx:for="{{summary.highRiskAlerts}}" wx:key="key">
      • {{item.label}}：{{item.per1000kcalText}}/千卡（上限 {{item.max}} {{item.unit}}）
    </view>
  </view>

  <!-- 近似估算食材黄灯提示 -->
  <view wx:if="{{summary.proxyNames}}" class="alert-warning">
    ⚠ 近似估算数据，建议优先选用实测肉类：{{summary.proxyNames}}
  </view>

  <!-- 食材结构占比（饼状图） -->
  <view wx:if="{{roleSlices.length > 0}}" class="card">
    <view class="section-header">
      <text class="section-title">📊 食材结构比例</text>
      <text class="muted-sm">按生鲜克重占比</text>
    </view>
    <view class="pie-layout">
      <view class="pie-ring" style="background: {{rolePieGradient}};">
        <view class="pie-hole">
          <text class="pie-center-val">{{summary.totalWeightG}}g</text>
          <text class="pie-center-sub">生鲜总重</text>
        </view>
      </view>
      <view class="pie-legend">
        <view wx:for="{{roleSlices}}" wx:key="role" class="pie-legend-row">
          <view class="pie-legend-left">
            <view class="pie-dot" style="background-color: {{item.color}};"></view>
            <text class="pie-legend-name">{{item.icon}} {{item.label}}</text>
          </view>
          <view class="pie-legend-right">
            <text class="pie-legend-pct">{{item.pct}}%</text>
            <text class="pie-legend-g">{{item.weight}}g</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 食材清单（支持查看/编辑双模式） -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">🥩 食材清单 ({{ingredientRows.length}} 项)</text>
      <text wx:if="{{isEditing}}" class="link-orange" bindtap="onOpenAddIngredient">+ 添加食材</text>
      <text wx:else class="muted-sm">生鲜可食部</text>
    </view>

    <block wx:if="{{!isEditing}}">
      <view wx:for="{{ingredientRows}}" wx:key="index" class="view-item">
        <view class="view-item-left">
          <view class="item-icon-box">{{item.roleIcon}}</view>
          <view class="item-main">
            <view class="item-name-line">
              <text class="item-name">{{item.name}}</text>
              <text class="badge {{item.badgeClass}}">{{item.badgeLabel}}</text>
            </view>
            <text class="muted-sm">{{item.roleLabel}} · 占总重 {{item.pct}}%</text>
            <text wx:if="{{item.isProxy}}" class="proxy-inline-sm">⚠ 近似估算数据，建议优先选用实测肉类</text>
          </view>
        </view>
        <text class="item-weight">{{item.weight}}g</text>
      </view>
    </block>

    <block wx:else>
      <view wx:for="{{ingredientRows}}" wx:key="index" class="edit-row">
        <view class="edit-row-top">
          <view class="edit-left" data-index="{{index}}" bindtap="onOpenReplaceIngredient">
            <text class="row-icon">{{item.roleIcon}}</text>
            <view class="row-info">
              <view class="item-name-line">
                <text class="item-name">{{item.name}}</text>
                <text class="badge {{item.badgeClass}}">{{item.badgeLabel}}</text>
              </view>
              <text class="muted-sm">{{item.roleLabel}} · 点击更换同类食材</text>
            </view>
          </view>
          <text class="del-btn" data-index="{{index}}" bindtap="onRemoveIngredient">删除</text>
        </view>
        <view class="weight-ctrl">
          <view class="step-btn" data-index="{{index}}" data-delta="-50" bindtap="onStepIngWeight">-50g</view>
          <view class="weight-input-wrap">
            <input
              class="weight-input"
              type="digit"
              value="{{item.weight}}"
              data-index="{{index}}"
              bindinput="onIngWeightInput"
            />
            <text class="unit-suffix">g</text>
          </view>
          <view class="step-btn" data-index="{{index}}" data-delta="50" bindtap="onStepIngWeight">+50g</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 补剂清单（各补剂独立管理，按实际营养成分累加） -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">💊 营养补剂 ({{supplementRows.length}} 项)</text>
      <view wx:if="{{isEditing}}" class="supp-header-actions">
        <text class="recalc-btn" bindtap="onRecalcSupplements">✨ 智能重算</text>
        <text class="link-orange" bindtap="onOpenAddSupplement">+ 添加</text>
      </view>
      <text wx:else class="muted-sm">按单批次总量</text>
    </view>

    <block wx:if="{{!isEditing}}">
      <view wx:for="{{supplementRows}}" wx:key="index" class="view-item">
        <view class="view-item-left">
          <view class="item-icon-box">💊</view>
          <view class="item-main">
            <text class="item-name">{{item.name}}</text>
            <text class="muted-sm">{{item.category}} · {{item.unitLabel}}</text>
          </view>
        </view>
        <text class="item-weight supp-val">{{item.amount}} {{item.unit}}</text>
      </view>
      <view wx:if="{{supplementRows.length === 0}}" class="muted-sm">未添加补剂</view>
    </block>

    <block wx:else>
      <view wx:for="{{supplementRows}}" wx:key="index" class="edit-row">
        <view class="edit-row-top">
          <view class="edit-left" data-index="{{index}}" bindtap="onOpenReplaceSupplement">
            <text class="row-icon">💊</text>
            <view class="row-info">
              <text class="item-name">{{item.name}}</text>
              <text class="muted-sm">{{item.category}} · {{item.unitLabel}} · 点击更换补剂</text>
            </view>
          </view>
          <text class="del-btn" data-index="{{index}}" bindtap="onRemoveSupplement">删除</text>
        </view>

        <view class="weight-ctrl">
          <view class="weight-input-wrap full-input">
            <input
              class="weight-input"
              type="digit"
              value="{{item.amount}}"
              data-index="{{index}}"
              bindinput="onSuppAmountInput"
            />
            <text class="unit-suffix">{{item.unit}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 补剂严谨性说明 -->
    <view wx:if="{{summary.hasUnquantifiedFishOilVE || summary.hasSyntheticVEReminder || summary.hasBComplexCholineNote}}" class="alert-info mt-16">
      <view wx:if="{{summary.hasUnquantifiedFishOilVE}}">• 鱼油所含 VE 未定量，不计入总 VE 统计。</view>
      <view wx:if="{{summary.hasSyntheticVEReminder}}">• 维生素 E 请核对天然/合成形式（合成 dl-α-生育酚乙酸酯按 0.45 折算）。</view>
      <view wx:if="{{summary.hasBComplexCholineNote}}">• 复合维 B 已同步累加按 41.1% 折算的元素胆碱。</view>
    </view>
  </view>

  <!-- 营养达标分析（顶部切换营养标准 + 自动判定阶段 + 不合格项统计与置顶） -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">🚦 营养达标分析</text>
      <text class="link-orange" bindtap="onOpenFullNutrients">全部 28 项 ›</text>
    </view>

    <!-- 切换营养标准（NRC / AAFCO） + 自动判定成幼猫阶段 -->
    <view class="std-bar">
      <view class="pill-group">
        <view class="pill-opt {{standard === 'NRC' ? 'pill-opt-active' : ''}}" data-val="NRC" bindtap="onSwitchStandard">NRC 2006</view>
        <view class="pill-opt {{standard === 'AAFCO' ? 'pill-opt-active' : ''}}" data-val="AAFCO" bindtap="onSwitchStandard">AAFCO</view>
      </view>
      <view class="stage-auto-tag">
        <text>自动判定：{{lifeStageText}}</text>
      </view>
    </view>

    <!-- 不合格项总览提示 -->
    <view wx:if="{{unqualifiedCount > 0}}" class="unqualified-banner">
      <text class="unqualified-banner-title">⚠ 共 {{unqualifiedCount}} 项未达标（{{unqualifiedDetailText}}），已置顶展示</text>
    </view>
    <view wx:else class="qualified-banner">
      <text class="qualified-banner-title">✓ 全部营养指标均已达标</text>
    </view>

    <view class="muted-sm mb-16">
      比对基准：每 1,000 kcal 代谢能含量（括号/小字为整份 {{summary.totalWeightG}}g 食谱总含量）
    </view>

    <view wx:if="{{summary.hasMissingData}}" class="alert-info mb-16">
      ℹ️ 含未检测项，不代表为 0（标有 * 的营养素存在部分食材原始库未报告项，汇总时已自动跳过）。
    </view>

    <view class="eval-table">
      <view
        wx:for="{{displayEvaluations}}"
        wx:key="key"
        class="eval-row {{item.status === 'red' ? 'eval-row-red' : item.status === 'yellow' ? 'eval-row-yellow' : ''}}"
      >
        <view class="eval-left">
          <text class="eval-name">{{item.label}}{{item.hasMissingSource ? ' *' : ''}}</text>
          <text class="eval-bounds">标准：{{item.boundsText}}{{item.key === 'ca_p_ratio' ? '' : ' /千卡'}}</text>
        </view>
        <view class="eval-right">
          <view class="eval-val-col">
            <text class="eval-val">{{item.per1000kcalText}}<text wx:if="{{item.key !== 'ca_p_ratio'}}" class="eval-per-unit">/千卡</text></text>
            <text wx:if="{{item.totalAmountText}}" class="eval-total-sub">{{item.totalAmountText}}</text>
          </view>
          <text class="traffic-dot traffic-{{item.status}}">{{item.statusSymbol}}</text>
        </view>
      </view>
    </view>

    <view class="btn-outline mt-20" bindtap="onOpenFullNutrients">查看全部 28 项营养明细（标准库顺序）</view>
  </view>

  <!-- 底部固定操作栏 -->
  <view class="bottom-bar">
    <block wx:if="{{isEditing}}">
      <view class="btn-secondary bar-half" bindtap="onToggleEdit">取消</view>
      <view class="btn-primary bar-half" bindtap="onSaveEdits">保存配方修改</view>
    </block>
    <block wx:else>
      <view class="bar-icon-btn" bindtap="onCopyRecipe">复制</view>
      <view class="bar-icon-btn bar-del" bindtap="onDeleteRecipe">删除</view>
      <view class="btn-primary bar-main" bindtap="onToggleActive">
        {{recipe.isActive ? '暂停执行该食谱' : '设为正在执行'}}
      </view>
    </block>
  </view>

  <!-- 全部 28 项营养详情弹窗（按标准库顺序展示） -->
  <view wx:if="{{showFullNutrients}}" class="modal-mask" bindtap="onCloseModals">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-header">
        <view>
          <text class="modal-title">全部 28 项营养分析</text>
          <view class="muted-sm">每 1,000 kcal ME · {{standard}} · {{lifeStageText}}</view>
        </view>
        <view class="modal-close" bindtap="onCloseModals">✕</view>
      </view>

      <scroll-view class="modal-scroll" scroll-y="true">
        <view wx:if="{{summary.hasMissingData}}" class="alert-info mb-16">
          ℹ️ 含未检测项，不代表为 0（标 * 项跳过未报告食材后累加）。
        </view>

        <view wx:for="{{groupedEvaluations}}" wx:key="group" class="eval-group">
          <view class="eval-group-title">{{item.group}}</view>
          <view wx:for="{{item.items}}" wx:for-item="ev" wx:key="key" class="eval-row">
            <view class="eval-left">
              <text class="eval-name">{{ev.label}}{{ev.hasMissingSource ? ' *' : ''}}</text>
              <text class="eval-bounds">{{ev.boundsText}}{{ev.key === 'ca_p_ratio' ? '' : ' /千卡'}}</text>
            </view>
            <view class="eval-right">
              <view class="eval-val-col">
                <text class="eval-val">{{ev.per1000kcalText}}<text wx:if="{{ev.key !== 'ca_p_ratio'}}" class="eval-per-unit">/千卡</text></text>
                <text wx:if="{{ev.totalAmountText}}" class="eval-total-sub">{{ev.totalAmountText}}</text>
              </view>
              <text class="traffic-dot traffic-{{ev.status}}">{{ev.statusSymbol}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 食材搜索选择弹窗（支持同类筛选 + 防重复） -->
  <view wx:if="{{showIngPicker}}" class="modal-mask" bindtap="onCloseModals">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">{{pickerIngIndex >= 0 ? '更换食材（优先展示同类）' : '添加食材'}}</text>
        <view class="modal-close" bindtap="onCloseModals">✕</view>
      </view>
      <view class="search-box">
        <text>🔍</text>
        <input class="search-input" placeholder="搜索 176 项食材..." value="{{ingPickerKeyword}}" bindinput="onIngPickerSearch" />
      </view>
      <scroll-view class="role-filter-scroll" scroll-x="true" enable-flex="true">
        <view
          wx:for="{{roleFilterTabs}}"
          wx:key="id"
          class="role-filter-chip {{ingPickerRole === item.id ? 'role-filter-chip-active' : ''}}"
          data-role="{{item.id}}"
          bindtap="onSelectIngPickerRole"
        >
          {{item.icon}} {{item.name}}
        </view>
      </scroll-view>
      <scroll-view class="modal-scroll" scroll-y="true">
        <view
          wx:for="{{pickerIngredients}}"
          wx:key="id"
          class="picker-item {{item.alreadyAdded ? 'picker-item-disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectPickerIngredient"
        >
          <text class="picker-icon">{{item.roleIcon}}</text>
          <view class="picker-main">
            <text class="picker-name">{{item.name}}</text>
            <text class="muted-sm">{{item.category}} · {{item.roleLabel}}</text>
          </view>
          <text wx:if="{{item.alreadyAdded}}" class="badge badge-stone">已添加</text>
          <text wx:else class="badge {{item.badgeClass}}">{{item.badgeLabel}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 补剂选择弹窗（纯中文名称 + 防重复） -->
  <view wx:if="{{showSuppPicker}}" class="modal-mask" bindtap="onCloseModals">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">{{pickerSuppIndex >= 0 ? '更换补剂' : '添加补剂'}}</text>
        <view class="modal-close" bindtap="onCloseModals">✕</view>
      </view>
      <scroll-view class="modal-scroll" scroll-y="true">
        <view
          wx:for="{{pickerSupplements}}"
          wx:key="id"
          class="picker-item {{item.alreadyAdded ? 'picker-item-disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectPickerSupplement"
        >
          <text class="picker-icon">💊</text>
          <view class="picker-main">
            <text class="picker-name">{{item.name}}</text>
            <text class="muted-sm">{{item.category}} · {{item.unit_label}}</text>
          </view>
          <text wx:if="{{item.alreadyAdded}}" class="badge badge-stone">已添加</text>
          <text wx:else class="badge badge-orange">选用</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
