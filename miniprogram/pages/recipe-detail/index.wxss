.detail-wrap {
  min-height: 100vh;
  padding: 24rpx 32rpx 190rpx;
  background-color: #F9F7F4;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.hero-title-wrap {
  flex: 1;
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #292524;
  margin-bottom: 10rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.edit-toggle-btn {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background-color: #FFFAF5;
  color: #FF7B4A;
  border: 1rpx solid #FED7AA;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.edit-toggle-active {
  background-color: #F5F5F4;
  color: #57534E;
  border-color: #E7E5E4;
}

.std-switch-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.pill-group {
  display: flex;
  background-color: #F5F5F4;
  border-radius: 999rpx;
  padding: 6rpx;
}

.pill-opt {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #78716C;
}

.pill-opt-active {
  background-color: #FFFFFF;
  color: #FF7B4A;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.kpi-grid {
  display: flex;
  justify-content: space-between;
  background-color: #F9F7F4;
  border-radius: 24rpx;
  padding: 20rpx 10rpx;
  margin-bottom: 20rpx;
}

.kpi-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.kpi-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
}

.val-green { color: #059669; }
.val-amber { color: #D97706; }
.val-red { color: #DC2626; }

.me-bar {
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  background-color: #F5F5F4;
  margin-bottom: 10rpx;
}

.me-seg { height: 100%; }
.me-pro { background-color: #FF7B4A; }
.me-fat { background-color: #FBBF24; }
.me-carb { background-color: #60A5FA; }

.me-legend {
  display: flex;
  justify-content: space-around;
  font-size: 22rpx;
  color: #78716C;
}

.alert-head {
  font-weight: 700;
  margin-bottom: 6rpx;
}

.role-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.role-chip {
  width: calc(50% - 7rpx);
  background-color: #F9F7F4;
  border-radius: 20rpx;
  padding: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.role-chip-icon {
  font-size: 32rpx;
}

.role-chip-body {
  flex: 1;
}

.role-chip-name {
  font-size: 23rpx;
  color: #44403C;
  font-weight: 600;
}

.role-chip-pct {
  font-size: 23rpx;
  font-weight: 800;
  color: #FF7B4A;
}

.role-track {
  height: 10rpx;
  background-color: #E7E5E4;
  border-radius: 999rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.role-fill {
  height: 100%;
  background-color: #FF7B4A;
  border-radius: 999rpx;
}

.view-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F5F4;
  gap: 14rpx;
}

.view-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.view-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.item-icon-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background-color: #FFFAF5;
  border: 1rpx solid #FFEDD5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.item-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.item-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.item-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #292524;
}

.proxy-inline-sm {
  font-size: 20rpx;
  color: #B45309;
}

.item-weight {
  font-size: 28rpx;
  font-weight: 800;
  color: #292524;
  flex-shrink: 0;
}

.supp-val {
  color: #FF7B4A;
}

.supp-header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.recalc-btn {
  font-size: 23rpx;
  font-weight: 700;
  color: #0369A1;
  background-color: #F0F9FF;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.edit-row {
  background-color: #F9F7F4;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 14rpx;
}

.edit-row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.edit-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.row-icon { font-size: 34rpx; }
.row-info { flex: 1; }

.del-btn {
  font-size: 23rpx;
  color: #EF4444;
  padding: 6rpx 12rpx;
}

.brand-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.brand-pill {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background-color: #FFFFFF;
  color: #57534E;
  border: 1rpx solid #E7E5E4;
}

.brand-pill-active {
  background-color: #FF7B4A;
  color: #FFFFFF;
  border-color: #FF7B4A;
}

.weight-ctrl {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-btn {
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  font-size: 24rpx;
  font-weight: 600;
  color: #57534E;
}

.weight-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 70rpx;
}

.full-input { width: 100%; }

.weight-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
  text-align: center;
}

.unit-suffix {
  font-size: 24rpx;
  color: #78716C;
  margin-left: 8rpx;
}

.mb-16 { margin-bottom: 16rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }

.eval-table {
  display: flex;
  flex-direction: column;
}

.eval-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F5F4;
  gap: 14rpx;
}

.eval-row:last-child {
  border-bottom: none;
}

.eval-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.eval-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #292524;
}

.eval-bounds {
  font-size: 21rpx;
  color: #A8A29E;
}

.eval-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.eval-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #292524;
}

.eval-group {
  margin-bottom: 24rpx;
}

.eval-group-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #FF7B4A;
  background-color: #FFFAF5;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  margin-bottom: 8rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #F5F5F4;
  padding: 18rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 14rpx;
  z-index: 100;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.bar-half { flex: 1; }

.bar-icon-btn {
  padding: 22rpx 26rpx;
  border-radius: 26rpx;
  background-color: #F5F5F4;
  color: #57534E;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-del {
  background-color: #FEF2F2;
  color: #DC2626;
}

.bar-main {
  flex: 1;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #F5F5F4;
}

.picker-icon { font-size: 34rpx; }

.picker-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.picker-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #292524;
}
