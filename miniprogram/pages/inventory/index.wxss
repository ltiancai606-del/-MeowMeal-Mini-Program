.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #292524;
  margin-bottom: 4rpx;
}

.add-btn {
  background-color: #FF7B4A;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 123, 74, 0.28);
}

.stat-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.stat-tab {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 22rpx;
  padding: 16rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  border: 2rpx solid #F5F5F4;
}

.stat-tab-active {
  border-color: #FF7B4A;
  background-color: #FFFAF5;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #292524;
}

.num-green {
  color: #059669;
}

.num-amber {
  color: #D97706;
}

.num-red {
  color: #DC2626;
}

.num-blue {
  color: #2563EB;
}

.stat-label {
  font-size: 20rpx;
  color: #78716C;
}

.search-icon {
  font-size: 26rpx;
}

.search-clear {
  font-size: 24rpx;
  color: #A8A29E;
  padding: 6rpx 10rpx;
}

.inv-card {
  padding: 26rpx;
  margin-bottom: 16rpx;
}

.inv-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.inv-icon-box {
  width: 82rpx;
  height: 82rpx;
  border-radius: 24rpx;
  background-color: #FFFAF5;
  border: 1rpx solid #FFEDD5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.inv-main {
  flex: 1;
  min-width: 0;
}

.inv-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.inv-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
}

.inv-sub-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.inv-right {
  text-align: right;
  flex-shrink: 0;
}

.inv-weight {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
}

.inv-price {
  display: block;
  font-size: 22rpx;
  color: #A8A29E;
  margin-top: 4rpx;
}

.empty-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 72rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
}

.empty-icon {
  font-size: 64rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #A8A29E;
}

.empty-btn {
  padding: 20rpx 44rpx;
  font-size: 28rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #57534E;
  margin-bottom: 10rpx;
}

.form-grid {
  display: flex;
  gap: 18rpx;
}

.half {
  flex: 1;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background-color: #F9F7F4;
  border: 1rpx solid #E7E5E4;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #292524;
}

.date-input {
  display: flex;
  align-items: center;
}

.picker-trigger {
  background-color: #F9F7F4;
  border: 1rpx solid #E7E5E4;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.picker-icon {
  font-size: 36rpx;
}

.picker-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
}

.picker-arrow {
  font-size: 24rpx;
  color: #FF7B4A;
  font-weight: 600;
}

.proxy-inline {
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background-color: #FFFBEB;
  border: 1rpx solid #FDE68A;
  color: #92400E;
  font-size: 22rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-bottom: 12rpx;
}

.action-del {
  width: 180rpx;
}

.action-save {
  flex: 1;
}

.picker-mask {
  z-index: 1010;
}

.picker-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F4;
}

.picker-row-active {
  background-color: #FFFAF5;
  border-radius: 18rpx;
}

.picker-row-icon {
  font-size: 34rpx;
}

.picker-row-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.picker-row-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #292524;
}
