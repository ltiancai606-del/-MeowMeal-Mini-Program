<view class="create-wrap">
  <!-- 顶部步骤条 -->
  <view class="step-bar">
    <view wx:for="{{steps}}" wx:key="num" class="step-item {{step >= item.num ? 'step-active' : ''}}">
      <view class="step-dot">{{item.num}}</view>
      <text class="step-label">{{item.label}}</text>
    </view>
  </view>

  <!-- Step 1: 基本信息与标准 -->
  <block wx:if="{{step === 1}}">
    <view class="card">
      <view class="section-title mb-20">1. 食谱名称</view>
      <input
        class="form-input"
        value="{{name}}"
        placeholder="例如：汤圆的冬季鸡猪均衡餐"
        bindinput="onNameInput"
      />
    </view>

    <view class="card">
      <view class="section-title mb-20">2. 选择适用猫咪（自动规避过敏原）</view>
      <view class="cat-select-grid">
        <view
          wx:for="{{catOptions}}"
          wx:key="id"
          class="cat-opt {{item.selected ? 'cat-opt-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="onToggleCat"
        >
          <text class="cat-opt-name">{{item.name}}</text>
          <text class="muted-sm">{{item.weight}}kg · {{item.age}}岁</text>
          <text wx:if="{{item.allergyText}}" class="allergy-tip">忌口: {{item.allergyText}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title mb-20">3. 营养标准与生命阶段</view>
      <view class="sub-label">参考标准（均统一为每 1,000 kcal ME）</view>
      <view class="seg-row mb-20">
        <view class="seg-card {{standard === 'NRC' ? 'seg-card-active' : ''}}" data-val="NRC" bindtap="onSelectStandard">
          <text class="seg-title">NRC 2006</text>
          <text class="muted-sm">学术推荐量 RA + SUL</text>
        </view>
        <view class="seg-card {{standard === 'AAFCO' ? 'seg-card-active' : ''}}" data-val="AAFCO" bindtap="onSelectStandard">
          <text class="seg-title">AAFCO 2016/2026</text>
          <text class="muted-sm">商业最低值 Min + Max</text>
        </view>
      </view>

      <view class="sub-label">生命阶段</view>
      <view class="seg-row">
        <view class="seg-card {{lifeStage === 'adult' ? 'seg-card-active' : ''}}" data-val="adult" bindtap="onSelectLifeStage">
          <text class="seg-title">成猫维持期</text>
          <text class="muted-sm">≥ 1 岁</text>
        </view>
        <view class="seg-card {{lifeStage === 'kitten' ? 'seg-card-active' : ''}}" data-val="kitten" bindtap="onSelectLifeStage">
          <text class="seg-title">幼猫生长期</text>
          <text class="muted-sm">&lt; 1 岁 / 孕哺期</text>
        </view>
      </view>
    </view>
  </block>

  <!-- Step 2: 配餐模式与分量 -->
  <block wx:if="{{step === 2}}">
    <view class="card">
      <view class="section-title mb-20">选择配餐模式</view>
      <view class="mode-card {{mode === 'by_need' ? 'mode-card-active' : ''}}" data-mode="by_need" bindtap="onSelectMode">
        <view class="mode-title">✨ 按营养需求智能配餐</view>
        <view class="muted-sm">按白肉 35% / 红肉 25% / 心脏 15% / 鱼类 10% / 青口贝 5% / 肝脏 5% / 其他内脏 5% 自动严选实测食材。</view>
      </view>
      <view class="mode-card {{mode === 'by_inventory' ? 'mode-card-active' : ''}}" data-mode="by_inventory" bindtap="onSelectMode">
        <view class="mode-title">🧊 按冰箱库存优先消耗</view>
        <view class="muted-sm">优先匹配冰箱里即将临期的可用库存，其余槽位自动用 L1/L2 实测肉类补齐。</view>
      </view>
    </view>

    <view class="card">
      <view class="section-title mb-20">设定制作天数与日食量</view>
      <view class="slider-row">
        <view class="row-between">
          <text class="sub-label">计划制作天数</text>
          <text class="val-highlight">{{days}} 天</text>
        </view>
        <slider min="3" max="30" step="1" value="{{days}}" activeColor="#FF7B4A" bindchange="onDaysChange" />
      </view>

      <view class="slider-row">
        <view class="row-between">
          <text class="sub-label">单只猫咪每日熟自制生重</text>
          <text class="val-highlight">{{dailyGrams}} g / 天</text>
        </view>
        <slider min="80" max="300" step="10" value="{{dailyGrams}}" activeColor="#FF7B4A" bindchange="onDailyGramsChange" />
      </view>

      <view class="target-summary">
        <text class="muted">本批次建议肉类总重（{{selectedCatCount}} 只猫 × {{days}} 天）：</text>
        <text class="target-num">{{targetTotalWeight}} g</text>
      </view>
    </view>
  </block>

  <!-- Step 3: 食材与补剂完整微调（类似编辑食谱） -->
  <block wx:if="{{step === 3}}">
    <!-- 实时营养概览条 -->
    <view class="card summary-card">
      <view class="summary-grid">
        <view class="summary-cell">
          <text class="summary-val">{{liveSummary.totalWeightG}}g</text>
          <text class="muted-sm">食材总重</text>
        </view>
        <view class="summary-cell">
          <text class="summary-val">{{liveSummary.totalKcal}}</text>
          <text class="muted-sm">总热量 kcal</text>
        </view>
        <view class="summary-cell">
          <text class="summary-val {{liveSummary.caPClass}}">{{liveSummary.caPRatioText}}</text>
          <text class="muted-sm">钙磷比 (1.1~1.4)</text>
        </view>
        <view class="summary-cell">
          <text class="summary-val">{{liveSummary.greenCount}}/{{liveSummary.coreTotal}}</text>
          <text class="muted-sm">核心绿灯</text>
        </view>
      </view>

      <!-- ME 供能比 -->
      <view class="me-bar">
        <view class="me-seg me-pro" style="width: {{liveSummary.proteinPct}}%;"></view>
        <view class="me-seg me-fat" style="width: {{liveSummary.fatPct}}%;"></view>
        <view class="me-seg me-carb" style="width: {{liveSummary.carbPct}}%;"></view>
      </view>
      <view class="me-legend">
        <text>蛋白 {{liveSummary.proteinPct}}%</text>
        <text>脂肪 {{liveSummary.fatPct}}%</text>
        <text>碳水 {{liveSummary.carbPct}}%</text>
      </view>
    </view>

    <!-- 高风险 SUL/Max 红灯警告 -->
    <view wx:if="{{liveSummary.highRiskAlerts.length > 0}}" class="alert-danger">
      <view class="alert-title">🚨 高风险超标警报（超过 SUL / Max 上限）</view>
      <view wx:for="{{liveSummary.highRiskAlerts}}" wx:key="key">
        • {{item.label}}：{{item.per1000kcalText}}（上限 {{item.max}} {{item.unit}}）
      </view>
    </view>

    <!-- 近似估算食材黄灯提示 -->
    <view wx:if="{{liveSummary.proxyNames}}" class="alert-warning">
      ⚠ 近似估算数据，建议优先选用实测肉类：{{liveSummary.proxyNames}}
    </view>

    <!-- 食材编辑区 -->
    <view class="card">
      <view class="section-header">
        <text class="section-title">🥩 食材清单 ({{ingredientRows.length}} 项)</text>
        <text class="link-orange" bindtap="onOpenAddIngredient">+ 添加食材</text>
      </view>

      <view wx:for="{{ingredientRows}}" wx:key="index" class="edit-row">
        <view class="edit-row-top">
          <view class="edit-left" data-index="{{index}}" bindtap="onOpenReplaceIngredient">
            <text class="row-icon">{{item.roleIcon}}</text>
            <view class="row-info">
              <view class="row-name-line">
                <text class="row-name">{{item.name}}</text>
                <text class="badge {{item.badgeClass}}">{{item.badgeLabel}}</text>
              </view>
              <text class="muted-sm">{{item.roleLabel}} · 点击更换食材</text>
            </view>
          </view>
          <text class="del-btn" data-index="{{index}}" bindtap="onRemoveIngredient">删除</text>
        </view>

        <view wx:if="{{item.isProxy}}" class="proxy-mini">⚠ 近似估算数据，建议优先选用实测肉类</view>

        <view class="weight-ctrl">
          <view class="step-btn" data-index="{{index}}" data-delta="-50" bindtap="onStepIngWeight">-50g</view>
          <view class="weight-input-wrap">
            <input
              class="weight-input"
              type="digit"
              value="{{item.weight}}"
              data-index="{{index}}"
              bindinput="onIngWeightInput"
            />
            <text class="unit-suffix">g</text>
          </view>
          <view class="step-btn" data-index="{{index}}" data-delta="50" bindtap="onStepIngWeight">+50g</view>
        </view>
      </view>
    </view>

    <!-- 补剂编辑区 -->
    <view class="card">
      <view class="section-header">
        <text class="section-title">💊 营养补剂 ({{supplementRows.length}} 项)</text>
        <view class="supp-header-actions">
          <text class="recalc-btn" bindtap="onRecalcSupplements">✨ 智能重算</text>
          <text class="link-orange" bindtap="onOpenAddSupplement">+ 添加补剂</text>
        </view>
      </view>

      <view wx:for="{{supplementRows}}" wx:key="index" class="edit-row">
        <view class="edit-row-top">
          <view class="edit-left" data-index="{{index}}" bindtap="onOpenReplaceSupplement">
            <text class="row-icon">💊</text>
            <view class="row-info">
              <view class="row-name-line">
                <text class="row-name">{{item.name}}</text>
              </view>
              <text class="muted-sm">{{item.category}} · {{item.unitLabel}} · 点击更换</text>
            </view>
          </view>
          <text class="del-btn" data-index="{{index}}" bindtap="onRemoveSupplement">删除</text>
        </view>

        <!-- 同类品牌快捷切换（自动重算用量） -->
        <view wx:if="{{item.alternatives.length > 1}}" class="brand-pills">
          <view
            wx:for="{{item.alternatives}}"
            wx:for-item="alt"
            wx:key="id"
            class="brand-pill {{alt.id === item.supplementId ? 'brand-pill-active' : ''}}"
            data-index="{{index}}"
            data-suppid="{{alt.id}}"
            bindtap="onSwitchSuppBrand"
          >
            {{alt.shortName}}
          </view>
        </view>

        <view class="weight-ctrl">
          <view class="weight-input-wrap full-input">
            <input
              class="weight-input"
              type="digit"
              value="{{item.amount}}"
              data-index="{{index}}"
              bindinput="onSuppAmountInput"
            />
            <text class="unit-suffix">{{item.unit}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{supplementRows.length === 0}}" class="muted-sm">暂未添加补剂，可点击上方“智能重算”自动匹配</view>

      <!-- 严谨性提示 -->
      <view wx:if="{{liveSummary.hasUnquantifiedFishOilVE || liveSummary.hasSyntheticVEReminder || liveSummary.hasBComplexCholineNote}}" class="alert-info mt-16">
        <view wx:if="{{liveSummary.hasUnquantifiedFishOilVE}}">• 鱼油中所含微量维生素 E 未定量，计算时不计入总 VE。</view>
        <view wx:if="{{liveSummary.hasSyntheticVEReminder}}">• 维生素 E 请核对天然/合成形式：合成 dl-α-生育酚乙酸酯需按 0.45 折算。</view>
        <view wx:if="{{liveSummary.hasBComplexCholineNote}}">• 复合维 B 已同步累加按 41.1% 折算的元素胆碱。</view>
      </view>
    </view>
  </block>

  <!-- Step 4: 最终确认 -->
  <block wx:if="{{step === 4}}">
    <view class="card card-warm">
      <view class="confirm-title">{{name}}</view>
      <view class="confirm-badges">
        <text class="badge badge-orange">{{standard}} 标准</text>
        <text class="badge badge-blue">{{lifeStage === 'kitten' ? '幼猫生长期' : '成猫维持期'}}</text>
        <text class="badge badge-stone">{{days}} 天食谱</text>
      </view>
      <view class="confirm-grid">
        <view class="confirm-cell">
          <text class="confirm-val">{{liveSummary.totalWeightG}} g</text>
          <text class="muted-sm">生鲜肉类总重</text>
        </view>
        <view class="confirm-cell">
          <text class="confirm-val">{{liveSummary.totalKcal}} kcal</text>
          <text class="muted-sm">总代谢能</text>
        </view>
        <view class="confirm-cell">
          <text class="confirm-val {{liveSummary.caPClass}}">{{liveSummary.caPRatioText}}</text>
          <text class="muted-sm">钙磷比</text>
        </view>
      </view>
    </view>

    <view wx:if="{{liveSummary.highRiskAlerts.length > 0}}" class="alert-danger">
      🚨 当前配方存在 {{liveSummary.highRiskAlerts.length}} 项超过 SUL/Max 上限的营养素，建议返回上一步调整肝脏或补剂用量。
    </view>

    <view class="card">
      <view class="section-title mb-16">食材与补剂清单</view>
      <view wx:for="{{ingredientRows}}" wx:key="index" class="review-line">
        <text>{{item.roleIcon}} {{item.name}}</text>
        <text class="review-val">{{item.weight}} g</text>
      </view>
      <view class="review-divider"></view>
      <view wx:for="{{supplementRows}}" wx:key="index" class="review-line">
        <text>💊 {{item.name}}</text>
        <text class="review-val">{{item.amount}} {{item.unit}}</text>
      </view>
    </view>

    <view wx:if="{{liveSummary.hasMissingData}}" class="alert-info">
      ℹ️ 含未检测项，不代表为 0；保存后可在详情页查看完整 28 项营养红黄绿灯报告。
    </view>
  </block>

  <!-- 底部固定操作栏（非 tabBar 页，底部安全区完整可见） -->
  <view class="bottom-bar">
    <view wx:if="{{step > 1}}" class="btn-secondary bottom-prev" bindtap="onPrevStep">上一步</view>
    <view wx:if="{{step < 4}}" class="btn-primary bottom-next" bindtap="onNextStep">
      {{step === 2 ? '生成并微调配方' : '下一步'}}
    </view>
    <view wx:else class="btn-primary bottom-next" bindtap="onSaveRecipe">保存并查看详情</view>
  </view>

  <!-- 食材搜索选择弹窗 -->
  <view wx:if="{{showIngPicker}}" class="modal-mask" bindtap="onClosePickers">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">{{pickerIngIndex >= 0 ? '更换食材' : '添加食材'}}</text>
        <view class="modal-close" bindtap="onClosePickers">✕</view>
      </view>
      <view class="search-box">
        <text>🔍</text>
        <input
          class="search-input"
          placeholder="搜索 176 项食材..."
          value="{{ingPickerKeyword}}"
          bindinput="onIngPickerSearch"
        />
      </view>
      <scroll-view class="modal-scroll" scroll-y="true">
        <view
          wx:for="{{pickerIngredients}}"
          wx:key="id"
          class="picker-item"
          data-id="{{item.id}}"
          bindtap="onSelectPickerIngredient"
        >
          <text class="picker-icon">{{item.roleIcon}}</text>
          <view class="picker-main">
            <text class="picker-name">{{item.name}}</text>
            <text class="muted-sm">{{item.category}} · {{item.roleLabel}}</text>
          </view>
          <text class="badge {{item.badgeClass}}">{{item.badgeLabel}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 补剂选择弹窗 -->
  <view wx:if="{{showSuppPicker}}" class="modal-mask" bindtap="onClosePickers">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title">{{pickerSuppIndex >= 0 ? '更换补剂' : '添加补剂'}}</text>
        <view class="modal-close" bindtap="onClosePickers">✕</view>
      </view>
      <scroll-view class="modal-scroll" scroll-y="true">
        <view
          wx:for="{{allSupplements}}"
          wx:key="id"
          class="picker-item"
          data-id="{{item.id}}"
          bindtap="onSelectPickerSupplement"
        >
          <text class="picker-icon">💊</text>
          <view class="picker-main">
            <text class="picker-name">{{item.name}}</text>
            <text class="muted-sm">{{item.category}} · {{item.unit_label}}</text>
          </view>
          <text class="badge badge-orange">选用</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
