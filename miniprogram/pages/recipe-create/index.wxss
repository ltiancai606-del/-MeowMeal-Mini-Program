.create-wrap {
  min-height: 100vh;
  padding: 24rpx 32rpx 190rpx;
  background-color: #F9F7F4;
}

.step-bar {
  display: flex;
  justify-content: space-between;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #F5F5F4;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #A8A29E;
}

.step-active {
  color: #FF7B4A;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background-color: #F5F5F4;
  color: #A8A29E;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-active .step-dot {
  background-color: #FF7B4A;
  color: #FFFFFF;
}

.step-label {
  font-size: 21rpx;
  font-weight: 600;
}

.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mt-16 { margin-top: 16rpx; }

.sub-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #57534E;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 86rpx;
  background-color: #F9F7F4;
  border: 1rpx solid #E7E5E4;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #292524;
}

.cat-select-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cat-opt {
  width: calc(50% - 7rpx);
  background-color: #F9F7F4;
  border: 2rpx solid #F5F5F4;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cat-opt-active {
  background-color: #FFFAF5;
  border-color: #FF7B4A;
}

.cat-opt-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
}

.allergy-tip {
  font-size: 20rpx;
  color: #DC2626;
}

.seg-row {
  display: flex;
  gap: 14rpx;
}

.seg-card {
  flex: 1;
  background-color: #F9F7F4;
  border: 2rpx solid #F5F5F4;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.seg-card-active {
  background-color: #FFFAF5;
  border-color: #FF7B4A;
}

.seg-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #292524;
}

.mode-card {
  background-color: #F9F7F4;
  border: 2rpx solid #F5F5F4;
  border-radius: 26rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.mode-card-active {
  background-color: #FFFAF5;
  border-color: #FF7B4A;
}

.mode-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
  margin-bottom: 8rpx;
}

.slider-row {
  margin-bottom: 24rpx;
}

.val-highlight {
  font-size: 28rpx;
  font-weight: 800;
  color: #FF7B4A;
}

.target-summary {
  background-color: #FFFAF5;
  border: 1rpx solid #FFEDD5;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.target-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #FF7B4A;
}

.summary-card {
  padding: 26rpx;
}

.summary-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.summary-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.summary-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
}

.val-green { color: #059669; }
.val-amber { color: #D97706; }
.val-red { color: #DC2626; }

.me-bar {
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  background-color: #F5F5F4;
  margin-bottom: 10rpx;
}

.me-seg { height: 100%; }
.me-pro { background-color: #FF7B4A; }
.me-fat { background-color: #FBBF24; }
.me-carb { background-color: #60A5FA; }

.me-legend {
  display: flex;
  justify-content: space-around;
  font-size: 21rpx;
  color: #78716C;
}

.alert-title {
  font-weight: 700;
  margin-bottom: 6rpx;
}

.supp-header-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.recalc-btn {
  font-size: 23rpx;
  font-weight: 700;
  color: #0369A1;
  background-color: #F0F9FF;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.edit-row {
  background-color: #F9F7F4;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.edit-row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.edit-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.row-icon {
  font-size: 36rpx;
}

.row-info {
  flex: 1;
}

.row-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.row-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #292524;
}

.del-btn {
  font-size: 23rpx;
  color: #EF4444;
  padding: 6rpx 12rpx;
}

.proxy-mini {
  font-size: 21rpx;
  color: #92400E;
  background-color: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 12rpx;
  padding: 6rpx 12rpx;
  margin-bottom: 12rpx;
}

.brand-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.brand-pill {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background-color: #FFFFFF;
  color: #57534E;
  border: 1rpx solid #E7E5E4;
}

.brand-pill-active {
  background-color: #FF7B4A;
  color: #FFFFFF;
  border-color: #FF7B4A;
}

.weight-ctrl {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-btn {
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  font-size: 24rpx;
  font-weight: 600;
  color: #57534E;
}

.weight-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 70rpx;
}

.full-input {
  width: 100%;
}

.weight-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
  text-align: center;
}

.unit-suffix {
  font-size: 24rpx;
  color: #78716C;
  margin-left: 8rpx;
}

.confirm-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #292524;
  margin-bottom: 14rpx;
}

.confirm-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.confirm-grid {
  display: flex;
  justify-content: space-between;
}

.confirm-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.confirm-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
}

.review-line {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #44403C;
}

.review-val {
  font-weight: 700;
  color: #292524;
}

.review-divider {
  height: 1rpx;
  background-color: #F5F5F4;
  margin: 12rpx 0;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #F5F5F4;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  z-index: 100;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.bottom-prev {
  width: 210rpx;
}

.bottom-next {
  flex: 1;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #F5F5F4;
}

.picker-icon {
  font-size: 34rpx;
}

.picker-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.picker-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #292524;
}

.picker-item-disabled {
  opacity: 0.48;
}

.role-filter-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: 16rpx;
  height: 64rpx;
}

.role-filter-chip {
  display: inline-flex;
  align-items: center;
  padding: 0 22rpx;
  height: 56rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background-color: #F5F5F4;
  color: #57534E;
  font-size: 23rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.role-filter-chip-active {
  background-color: #FF7B4A;
  color: #FFFFFF;
}

/* Step 4 食谱详情编辑态样式 */
.mt-20 { margin-top: 20rpx; }

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.hero-title-wrap {
  flex: 1;
}

.hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #292524;
  margin-bottom: 10rpx;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.kpi-grid {
  display: flex;
  justify-content: space-between;
  background-color: #F9F7F4;
  border-radius: 24rpx;
  padding: 20rpx 10rpx;
  margin-bottom: 20rpx;
}

.kpi-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.kpi-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
}

.pie-layout {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding-top: 8rpx;
}

.pie-ring {
  width: 224rpx;
  height: 224rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.pie-hole {
  width: 132rpx;
  height: 132rpx;
  border-radius: 999rpx;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.pie-center-val {
  font-size: 26rpx;
  font-weight: 800;
  color: #292524;
}

.pie-center-sub {
  font-size: 19rpx;
  color: #78716C;
}

.pie-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.pie-legend-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.pie-legend-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.pie-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.pie-legend-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #44403C;
}

.pie-legend-right {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-shrink: 0;
}

.pie-legend-pct {
  font-size: 25rpx;
  font-weight: 800;
  color: #292524;
}

.pie-legend-g {
  font-size: 21rpx;
  color: #78716C;
}

.std-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.pill-group {
  display: flex;
  background-color: #F5F5F4;
  border-radius: 999rpx;
  padding: 6rpx;
}

.pill-opt {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #78716C;
}

.pill-opt-active {
  background-color: #FFFFFF;
  color: #FF7B4A;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stage-auto-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #57534E;
  background-color: #F5F5F4;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
}

.unqualified-banner {
  background-color: #FEF2F2;
  border: 1rpx solid #FECACA;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.unqualified-banner-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #DC2626;
}

.qualified-banner {
  background-color: #ECFDF5;
  border: 1rpx solid #A7F3D0;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 14rpx;
}

.qualified-banner-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #059669;
}

.eval-table {
  display: flex;
  flex-direction: column;
}

.eval-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F5F4;
  gap: 14rpx;
}

.eval-row:last-child {
  border-bottom: none;
}

.eval-row-red {
  background-color: #FFF5F5;
  padding-left: 14rpx;
  padding-right: 14rpx;
  border-radius: 14rpx;
  margin-bottom: 6rpx;
  border-bottom-color: transparent;
}

.eval-row-yellow {
  background-color: #FFFBEB;
  padding-left: 14rpx;
  padding-right: 14rpx;
  border-radius: 14rpx;
  margin-bottom: 6rpx;
  border-bottom-color: transparent;
}

.eval-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.eval-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #292524;
}

.eval-bounds {
  font-size: 21rpx;
  color: #A8A29E;
}

.eval-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.eval-val-col {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}

.eval-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #292524;
}

.eval-per-unit {
  font-size: 20rpx;
  font-weight: 500;
  color: #78716C;
  margin-left: 2rpx;
}

.eval-total-sub {
  font-size: 20rpx;
  color: #78716C;
}

.eval-group {
  margin-bottom: 24rpx;
}

.eval-group-title {
  font-size: 25rpx;
  font-weight: 700;
  color: #FF7B4A;
  background-color: #FFFAF5;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  margin-bottom: 8rpx;
}

/* 冰箱反推标识徽章 */
.fridge-legend-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  background-color: #F0F9FF;
  border: 1rpx solid #BAE6FD;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.fridge-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background-color: #E0F2FE;
  color: #0369A1;
  border: 1rpx solid #BAE6FD;
  font-size: 20rpx;
  font-weight: 700;
}

.buy-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background-color: #FFF7ED;
  color: #C2410C;
  border: 1rpx solid #FED7AA;
  font-size: 20rpx;
  font-weight: 700;
}

.smart-btn {
  font-size: 23rpx;
  font-weight: 700;
  color: #7C3AED;
  background-color: #F5F3FF;
  border: 1rpx solid #DDD6FE;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.modal-sheet-tall {
  height: 82vh;
  max-height: 82vh;
}

.picker-split {
  flex: 1;
  min-height: 0;
  display: flex;
  gap: 14rpx;
  overflow: hidden;
}

.picker-cat-sidebar {
  width: 126rpx;
  height: 100%;
  background-color: #F9F7F4;
  border-radius: 20rpx;
  padding: 8rpx 6rpx;
  flex-shrink: 0;
}

.picker-cat-item {
  text-align: center;
  padding: 16rpx 8rpx;
  margin-bottom: 6rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #57534E;
}

.picker-cat-item-active {
  background-color: #FFFFFF;
  color: #FF7B4A;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.picker-main-scroll {
  flex: 1;
  min-width: 0;
  height: 100%;
}

.picker-empty {
  text-align: center;
  padding: 60rpx 20rpx;
  font-size: 24rpx;
  color: #A8A29E;
}

.smart-textarea {
  width: 100%;
  height: 200rpx;
  background-color: #F9F7F4;
  border: 1rpx solid #E7E5E4;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #292524;
  line-height: 1.5;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.smart-preview-scroll {
  max-height: 300rpx;
  margin-bottom: 18rpx;
}

.smart-preview-head {
  font-size: 23rpx;
  font-weight: 700;
  color: #059669;
  margin-bottom: 10rpx;
}

.smart-match-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  background-color: #F9F7F4;
  border-radius: 14rpx;
  margin-bottom: 8rpx;
}

.smart-match-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #292524;
  flex: 1;
}

.smart-match-weight {
  font-size: 24rpx;
  font-weight: 800;
  color: #FF7B4A;
  margin-left: 12rpx;
}

.smart-unmatched-box {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  background-color: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #B45309;
}

.smart-actions {
  display: flex;
  gap: 14rpx;
}

.smart-cancel {
  width: 180rpx;
}

.smart-confirm {
  flex: 1;
}

.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F5F5F4;
  z-index: 500;
}

.custom-nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}

.custom-nav-back {
  width: 88rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding-left: 10rpx;
}

.custom-nav-chevron {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #1C1917;
  border-bottom: 4rpx solid #1C1917;
  transform: rotate(45deg);
}

.custom-nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1917;
  text-align: center;
}

.custom-nav-right {
  width: 88rpx;
}
