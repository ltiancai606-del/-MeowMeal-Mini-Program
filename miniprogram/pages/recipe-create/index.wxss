.create-wrap {
  min-height: 100vh;
  padding: 24rpx 32rpx 190rpx;
  background-color: #F9F7F4;
}

.step-bar {
  display: flex;
  justify-content: space-between;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #F5F5F4;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: #A8A29E;
}

.step-active {
  color: #FF7B4A;
}

.step-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background-color: #F5F5F4;
  color: #A8A29E;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-active .step-dot {
  background-color: #FF7B4A;
  color: #FFFFFF;
}

.step-label {
  font-size: 21rpx;
  font-weight: 600;
}

.mb-16 { margin-bottom: 16rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mt-16 { margin-top: 16rpx; }

.sub-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #57534E;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 86rpx;
  background-color: #F9F7F4;
  border: 1rpx solid #E7E5E4;
  border-radius: 22rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #292524;
}

.cat-select-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.cat-opt {
  width: calc(50% - 7rpx);
  background-color: #F9F7F4;
  border: 2rpx solid #F5F5F4;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cat-opt-active {
  background-color: #FFFAF5;
  border-color: #FF7B4A;
}

.cat-opt-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
}

.allergy-tip {
  font-size: 20rpx;
  color: #DC2626;
}

.seg-row {
  display: flex;
  gap: 14rpx;
}

.seg-card {
  flex: 1;
  background-color: #F9F7F4;
  border: 2rpx solid #F5F5F4;
  border-radius: 24rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.seg-card-active {
  background-color: #FFFAF5;
  border-color: #FF7B4A;
}

.seg-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #292524;
}

.mode-card {
  background-color: #F9F7F4;
  border: 2rpx solid #F5F5F4;
  border-radius: 26rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.mode-card-active {
  background-color: #FFFAF5;
  border-color: #FF7B4A;
}

.mode-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
  margin-bottom: 8rpx;
}

.slider-row {
  margin-bottom: 24rpx;
}

.val-highlight {
  font-size: 28rpx;
  font-weight: 800;
  color: #FF7B4A;
}

.target-summary {
  background-color: #FFFAF5;
  border: 1rpx solid #FFEDD5;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.target-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #FF7B4A;
}

.summary-card {
  padding: 26rpx;
}

.summary-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.summary-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.summary-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
}

.val-green { color: #059669; }
.val-amber { color: #D97706; }
.val-red { color: #DC2626; }

.me-bar {
  height: 16rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  background-color: #F5F5F4;
  margin-bottom: 10rpx;
}

.me-seg { height: 100%; }
.me-pro { background-color: #FF7B4A; }
.me-fat { background-color: #FBBF24; }
.me-carb { background-color: #60A5FA; }

.me-legend {
  display: flex;
  justify-content: space-around;
  font-size: 21rpx;
  color: #78716C;
}

.alert-title {
  font-weight: 700;
  margin-bottom: 6rpx;
}

.supp-header-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.recalc-btn {
  font-size: 23rpx;
  font-weight: 700;
  color: #0369A1;
  background-color: #F0F9FF;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.edit-row {
  background-color: #F9F7F4;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.edit-row-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.edit-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.row-icon {
  font-size: 36rpx;
}

.row-info {
  flex: 1;
}

.row-name-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.row-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #292524;
}

.del-btn {
  font-size: 23rpx;
  color: #EF4444;
  padding: 6rpx 12rpx;
}

.proxy-mini {
  font-size: 21rpx;
  color: #92400E;
  background-color: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 12rpx;
  padding: 6rpx 12rpx;
  margin-bottom: 12rpx;
}

.brand-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.brand-pill {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background-color: #FFFFFF;
  color: #57534E;
  border: 1rpx solid #E7E5E4;
}

.brand-pill-active {
  background-color: #FF7B4A;
  color: #FFFFFF;
  border-color: #FF7B4A;
}

.weight-ctrl {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-btn {
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  font-size: 24rpx;
  font-weight: 600;
  color: #57534E;
}

.weight-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border: 1rpx solid #E7E5E4;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 70rpx;
}

.full-input {
  width: 100%;
}

.weight-input {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #292524;
  text-align: center;
}

.unit-suffix {
  font-size: 24rpx;
  color: #78716C;
  margin-left: 8rpx;
}

.confirm-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #292524;
  margin-bottom: 14rpx;
}

.confirm-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.confirm-grid {
  display: flex;
  justify-content: space-between;
}

.confirm-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.confirm-val {
  font-size: 30rpx;
  font-weight: 800;
  color: #292524;
}

.review-line {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #44403C;
}

.review-val {
  font-weight: 700;
  color: #292524;
}

.review-divider {
  height: 1rpx;
  background-color: #F5F5F4;
  margin: 12rpx 0;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #F5F5F4;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  z-index: 100;
  box-shadow: 0 -6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.bottom-prev {
  width: 210rpx;
}

.bottom-next {
  flex: 1;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 12rpx;
  border-bottom: 1rpx solid #F5F5F4;
}

.picker-icon {
  font-size: 34rpx;
}

.picker-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.picker-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #292524;
}
